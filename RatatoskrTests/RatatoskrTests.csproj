<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>org.GraphDefined.Vanaheimr.Ratatoskr.Tests</RootNamespace>
    <AssemblyName>org.GraphDefined.Vanaheimr.Ratatoskr.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ratatoskr\Ratatoskr.csproj" />

    <!--
      The federation tests resolve and bind themselves: IPPort, IPv4Address,
      IPSocket and the DNSClient come from Hermod, not from Ratatoskr. Listed
      expressly for the same reason as the packages over there - whoever uses
      a transitive dependency directly loses it at the moment at which the
      previous owner puts it down.
    -->
    <ProjectReference Include="..\..\Hermod\Hermod\Hermod.csproj" />
  </ItemGroup>

</Project>
