<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>org.GraphDefined.Vanaheimr.Ratatoskr</RootNamespace>
    <AssemblyName>org.GraphDefined.Vanaheimr.Ratatoskr</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.10" />

    <!--
      OMEMO (XEP-0384) braucht X25519 und Ed25519. Die BCL hat beides nicht -
      in System.Security.Cryptography.dll von .NET 10 kommt "X25519" kein
      einziges Mal vor -, und Kurvenarithmetik von Hand ist der eine Ort, an
      dem ein Fehler nicht auffaellt und alles kostet.

      Beide Pakete ausdruecklich aufgefuehrt, obwohl Hermod sie schon
      mitbringt: Wer eine transitive Abhaengigkeit direkt benutzt, verliert sie
      in dem Augenblick, in dem der Vorbesitzer sie ablegt.
    -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="org.GraphDefined.Vanaheimr.Ratatoskr.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Hermod\Hermod\Hermod.csproj" />
  </ItemGroup>

</Project>
