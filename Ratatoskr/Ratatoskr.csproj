<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>org.GraphDefined.Vanaheimr.Ratatoskr</RootNamespace>
    <AssemblyName>org.GraphDefined.Vanaheimr.Ratatoskr</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.10" />

    <!--
      OMEMO (XEP-0384) needs X25519 and Ed25519. The BCL has neither - in
      System.Security.Cryptography.dll of .NET 10 the string "X25519" does not
      appear a single time -, and curve arithmetic by hand is the one place
      where an error does not come out and costs everything.

      Both packages listed expressly although Hermod brings them along
      already: whoever uses a transitive dependency directly loses it at the
      moment at which the previous owner puts it down.
    -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="org.GraphDefined.Vanaheimr.Ratatoskr.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Hermod\Hermod\Hermod.csproj" />
  </ItemGroup>

</Project>
